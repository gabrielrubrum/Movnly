generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  password           String
  name               String
  role               String         @default("PASSENGER")
  stripeCustomerId   String?        @unique
  isEmailVerified    Boolean        @default(false)
  verificationToken  String?
  resetToken         String?
  resetTokenExpires  DateTime?
  twoFactorSecret    String?
  isTwoFactorEnabled Boolean        @default(false)
  tokenVersion       Int            @default(0)
  phone              String?
  defaultCategory    String         @default("smart")
  notificationsPref  String         @default("email")
  silentRide         Boolean        @default(false)
  pushToken          String?
  pushPlatform       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  auditLogs          AuditLog[]
  assignedBookings   Booking[]      @relation("DriverBookings")
  bookings           Booking[]
  partnerBookings    Booking[]      @relation("PartnerBookings")
  chatMessages       ChatMessage[]
  driverProfile      DriverProfile?
  partnerProfile     PartnerProfile?
  driverPayouts      DriverPayout[]
}

model DriverProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  license         String
  status          String   @default("OFFLINE")
  stripeAccountId String?  @unique
  bankName        String?
  iban            String?
  vehicleId       String?
  isVerified      Boolean  @default(false)
  idDocument      String?
  drivingLicense  String?
  vehicleDocs     String?
  lastLat         Float?
  lastLng         Float?
  lastLocationAt  DateTime?
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id])
  user            User     @relation(fields: [userId], references: [id])
}

model Vehicle {
  id       String          @id @default(uuid())
  model    String
  plate    String          @unique
  type     String
  capacity Int
  drivers  DriverProfile[]
}

model Booking {
  id              String        @id @default(uuid())
  passengerId     String
  partnerId       String?
  from            String
  to              String
  pickupTime      DateTime
  category        String        @default("smart")
  status          String        @default("PENDING")
  price           Float?
  paymentIntentId String?       @unique
  paymentStatus   String        @default("UNPAID")
  platformFee     Float?
  driverAmount    Float?
  partnerCommission Float?
  passengers      Int?
  luggage         Int?
  flightNumber    String?
  pin             String?
  pinAttempts     Int           @default(0)
  lockedUntil     DateTime?
  tripStartedAt   DateTime?
  driverId        String?
  originalAmountEUR Float?       // Original total amount in EUR
  driverAmountEUR  Float?       // Driver amount in EUR
  platformFeeEUR  Float?       // Platform fee in EUR
  chargedAmount   Float?       // Amount actually charged (converted if BRL)
  chargedCurrency String?       // Currency actually charged (eur, brl, or usd)
  exchangeRate    Float?       // Exchange rate used if converted
  detectionCountry String?      // Country detected for currency selection
  detectionMethod String?      // Method used for currency detection
  transferGroupId  String?      // Stripe Connect transfer group ID
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  driver          User?         @relation("DriverBookings", fields: [driverId], references: [id])
  partner         User?         @relation("PartnerBookings", fields: [partnerId], references: [id])
  passenger       User          @relation(fields: [passengerId], references: [id])
  transactions    Transaction[]
  auditLogs       AuditLog[]
  chatMessages    ChatMessage[]
  rating          Rating?
  payments        Payment[]
  driverPayouts   DriverPayout[]
  bookingPricing  BookingPricing?
  bookingExtras   BookingExtra[]
  passengerData   BookingPassenger?
}

model Transaction {
  id        String   @id @default(uuid())
  bookingId String
  amount    Float
  type      String
  status    String
  provider    String   @default("STRIPE")
  isDistributed Boolean @default(false)
  availableAt DateTime?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  bookingId String?
  action    String
  resource  String?
  metadata  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  booking   Booking? @relation(fields: [bookingId], references: [id])
}

model ChatMessage {
  id        String   @id @default(uuid())
  bookingId String
  senderId  String
  content   String
  createdAt DateTime @default(now())
  
  booking   Booking @relation(fields: [bookingId], references: [id])
  sender    User    @relation(fields: [senderId], references: [id])
}

model Tour {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Float
  duration    String
  image       String?
  location    String
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Rating {
  id          String   @id @default(uuid())
  bookingId   String   @unique
  driverId    String
  passengerId String
  score       Int      // 1-5
  comment     String?
  createdAt   DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id])
}

model Payment {
  id                    String   @id @default(uuid())
  bookingId             String
  stripePaymentIntentId String?  @unique
  stripeChargeId        String?  @unique
  amount                Int
  currency              String   @default("eur") // eur, brl, or usd
  originalAmountEUR     Float?   // Original amount in EUR before conversion
  driverAmountEUR       Float?   // Driver amount in EUR
  platformFeeEUR        Float?   // Platform fee in EUR
  exchangeRate          Float?   // Exchange rate used if converted
  status                String   @default("pending") // pending, succeeded, failed
  paymentMethod         String?
  paymentMethodType     String?  // card, apple_pay, google_pay, etc.
  cardCountry           String?  // Country of the card used
  cardBrand             String?  // visa, mastercard, etc.
  riskLevel             String?
  riskScore             Int?
  failureCode           String?
  failureMessage        String?
  transferId            String?  // Stripe Connect transfer ID
  transferStatus        String?  // pending, paid, failed
  threeDSecure          String?  // required, succeeded, failed
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  booking               Booking  @relation(fields: [bookingId], references: [id])
}

model DriverPayout {
  id              String   @id @default(uuid())
  bookingId       String
  driverId        String
  stripeAccountId String
  amount          Int
  currency        String   @default("eur") // eur, brl, or usd
  originalAmountEUR Float?  // Original amount in EUR
  exchangeRate    Float?   // Exchange rate used if converted
  status          String   @default("pending") // pending, in_transit, paid, failed
  transferId      String?  @unique
  transferGroupId String?  // Stripe Connect transfer group ID
  failureCode     String?
  failureMessage  String?
  availableAt     DateTime?
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  booking         Booking  @relation(fields: [bookingId], references: [id])
  driver          User     @relation(fields: [driverId], references: [id])
}

model StripeEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique
  type      String
  data      String   // JSON stringified
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model BookingPricing {
  id           String   @id @default(uuid())
  bookingId    String   @unique
  baseFare     Int
  vehicleClass String
  extras       Int      @default(0)
  nightFee     Int      @default(0)
  weekendFee   Int      @default(0)
  holidayFee   Int      @default(0)
  distanceFee  Int      @default(0)
  platformFee  Int      @default(0)
  driverAmount Int      @default(0)
  totalAmount  Int
  currency     String   @default("eur")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  booking      Booking  @relation(fields: [bookingId], references: [id])
}

model BookingExtra {
  id        String   @id @default(uuid())
  bookingId String
  extraId   String
  price     Int
  name      String
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id])
}

model BookingPassenger {
  id        String   @id @default(uuid())
  bookingId String   @unique
  name      String
  email     String
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id])
}

model PartnerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  organization    String
  type            String   @default("hotel")
  commissionRate  Float    @default(10)
  address         String?
  city            String   @default("Lisboa")
  country         String   @default("Portugal")
  contactPhone    String?
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
  commissions     PartnerCommission[]
}

model PartnerCommission {
  id          String   @id @default(uuid())
  partnerId   String
  bookingId   String   @unique
  amount      Float
  currency    String   @default("eur")
  rate        Float
  status      String   @default("pending")
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  partner     PartnerProfile @relation(fields: [partnerId], references: [id])
}

model ExchangeRate {
  id          String   @id @default(uuid())
  fromCurrency String   // EUR, BRL, USD
  toCurrency   String   // EUR, BRL, USD
  rate        Float
  source      String   @default("api") // api, manual, stripe
  validFrom   DateTime @default(now())
  validTo     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([fromCurrency, toCurrency, validFrom])
  @@index([fromCurrency])
  @@index([toCurrency])
  @@index([validFrom])
  @@index([validTo])
}

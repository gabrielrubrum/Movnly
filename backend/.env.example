# --- MOVNLY PRODUCTION ENVIRONMENT TEMPLATE ---

# Database (Prisma)
# Production: postgresql://user:password@host:port/db?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/nexrice"

# Security
JWT_SECRET="generate-a-long-random-string-here"
ENCRYPTION_KEY="another-random-string-for-sensitive-data"

# Server
PORT=3002
NODE_ENV="production"
FRONTEND_URL="https://movnly.com"
NEXT_PUBLIC_APP_URL="https://movnly.com"

# Stripe Payments (live keys — charges in EUR/BRL based on customer country)
STRIPE_SECRET_KEY="sk_live_xxxxxxxx"
STRIPE_PUBLISHABLE_KEY="pk_live_xxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxx"
STRIPE_SUCCESS_URL="https://movnly.com/booking/confirmation"
STRIPE_CANCEL_URL="https://movnly.com/reservar"

# Currency Configuration
# Default EUR to BRL exchange rate (fallback if API fails)
DEFAULT_EUR_BRL_RATE=6.00

# Email (Resend or SMTP)
# Option A: Resend (Recommended)
RESEND_API_KEY="re_..."

# Option B: Standard SMTP
MAIL_HOST="smtp.provider.com"
MAIL_PORT=587
MAIL_USER="noreply@nexrice.com"
MAIL_PASS="your-password"

# Google Maps (For Distance Calculations)
GOOGLE_MAPS_API_KEY="AIza..."

# Social Authentication (OAuth 2.0)
# Register at Cloud Console (Google) and Developer Portal (Apple)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
APPLE_CLIENT_ID="com.nexrice.app"
APPLE_TEAM_ID="YOUR_TEAM_ID"
APPLE_KEY_ID="YOUR_KEY_ID"
APPLE_KEY_FILE_PATH="secrets/AuthKey_XYZ.p8"

# Real-time Infrastructure
NEXT_PUBLIC_SOCKET_URL="https://nexrice.com"

# Admin Configuration
ADMIN_EMAIL="admin@nexrice.com"
ADMIN_PASSWORD="set-a-strong-password"

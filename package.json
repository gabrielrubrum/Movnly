{
  "name": "movnly-monorepo",
  "version": "1.0.0",
  "description": "MOVNLY Monorepo — Frontend (Next.js) + Backend (NestJS)",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:db": "docker start movnly-db",
    "start:backend": "powershell -NoExit -ExecutionPolicy Bypass -File scripts/start-backend.ps1",
    "start:all": "powershell -ExecutionPolicy Bypass -File scripts/start-all.ps1",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:mobile": "cd mobile && npm start",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "install:all": "cd frontend && npm install && cd ../backend && npm install && cd ../mobile && npm install",
    "setup:mobile": "powershell -ExecutionPolicy Bypass -File scripts/setup-mobile.ps1",
    "db:up": "docker run -d --name movnly-db -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=password -e POSTGRES_DB=movnly -p 5433:5432 postgres:15",
    "db:migrate": "cd backend && npx prisma migrate deploy",
    "db:seed": "cd backend && npx ts-node prisma/seed.ts",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && npm run lint"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
